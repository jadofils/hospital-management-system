<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="hospital.management.pages.auth.RolesPageController">

    <stylesheets>
        <URL value="@../../css/global.css"/>
        <URL value="@../../css/table.css"/>
        <URL value="@../../css/buttons.css"/>
        <URL value="@../../css/search.css"/>
        <URL value="@../../css/form.css"/>
        <URL value="@../../css/modal.css"/>
        <URL value="@../../css/alerts.css"/>
        <URL value="@../../css/spinner.css"/>
        <URL value="@../../css/tabs.css"/>
    </stylesheets>

    <BorderPane styleClass="page-root">

    <top><fx:include source="/hospital/management/frontend/components/navbar/navbar.fxml"/></top>
    <left><fx:include fx:id="sidebar" source="/hospital/management/frontend/components/sidebar/sidebar.fxml"/></left>
    <right><fx:include fx:id="rightSidebar" source="/hospital/management/frontend/components/right-sidebar/right-sidebar.fxml"/></right>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox styleClass="page-content" spacing="16">

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-user-shield" iconSize="18" styleClass="page-title-icon"/>
                    <Label text="Roles &amp; Permissions" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="continueBtn" styleClass="continue-button"/>
                </HBox>

                <TabPane tabClosingPolicy="UNAVAILABLE">

                    <!-- ═══════════════ ROLES ═══════════════ -->
                    <Tab text="Roles">
                        <VBox spacing="16" style="-fx-padding: 16px 0 0 0;">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <HBox styleClass="search-input-box" alignment="CENTER_LEFT" spacing="6">
                                    <FontIcon iconLiteral="fas-search" iconSize="13" styleClass="search-icon"/>
                                    <TextField fx:id="roleSearchField" promptText="Search roles..."
                                               styleClass="search-field" prefWidth="260" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="addRoleBtn" styleClass="primary-button" contentDisplay="LEFT" text="Add Role">
                                    <graphic><FontIcon iconLiteral="fas-plus" iconSize="13"/></graphic>
                                </Button>
                                <fx:include fx:id="roleSortBar" source="/hospital/management/frontend/components/sortbar/sort-bar.fxml"/>
                            </HBox>
                            <fx:include fx:id="roleTable"
                                        source="/hospital/management/frontend/components/table/role-table.fxml"
                                        VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </Tab>

                    <!-- ═══════════════ PERMISSIONS ═══════════════ -->
                    <Tab text="Permissions">
                        <VBox spacing="16" style="-fx-padding: 16px 0 0 0;">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <HBox styleClass="search-input-box" alignment="CENTER_LEFT" spacing="6">
                                    <FontIcon iconLiteral="fas-search" iconSize="13" styleClass="search-icon"/>
                                    <TextField fx:id="permissionSearchField" promptText="Search by resource or action..."
                                               styleClass="search-field" prefWidth="260" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <fx:include fx:id="permissionTable"
                                        source="/hospital/management/frontend/components/table/permission-cards.fxml"
                                        VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </Tab>

                </TabPane>
            </VBox>
        </ScrollPane>
    </center>

    <bottom><fx:include source="/hospital/management/frontend/components/footer/footer.fxml"/></bottom>
    </BorderPane>

    <fx:include fx:id="formDialog" source="/hospital/management/frontend/components/formdialog/form-dialog.fxml"/>
    <fx:include fx:id="confirmModal" source="/hospital/management/frontend/components/modal/modal.fxml"/>
    <fx:include fx:id="detailView" source="/hospital/management/frontend/components/detailview/detail-view.fxml"/>

    <StackPane StackPane.alignment="BOTTOM_RIGHT" styleClass="toast-anchor" pickOnBounds="false">
        <fx:include fx:id="toast" source="/hospital/management/frontend/components/toast/toast.fxml"/>
    </StackPane>
</StackPane>
