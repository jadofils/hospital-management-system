<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="hospital.management.pages.doctor.DoctorsPageController">

    <stylesheets>
        <URL value="@../../css/global.css"/>
        <URL value="@../../css/table.css"/>
        <URL value="@../../css/buttons.css"/>
        <URL value="@../../css/search.css"/>
        <URL value="@../../css/form.css"/>
        <URL value="@../../css/modal.css"/>
        <URL value="@../../css/alerts.css"/>
        <URL value="@../../css/spinner.css"/>
    </stylesheets>

    <BorderPane styleClass="page-root">

    <top><fx:include source="/hospital/management/frontend/components/navbar/navbar.fxml"/></top>
    <left><fx:include fx:id="sidebar" source="/hospital/management/frontend/components/sidebar/sidebar.fxml"/></left>
    <right><fx:include fx:id="rightSidebar" source="/hospital/management/frontend/components/right-sidebar/right-sidebar.fxml"/></right>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox styleClass="page-content" spacing="16">

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-user-md" iconSize="18" styleClass="page-title-icon"/>
                    <Label text="Doctors" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" text="" styleClass="label-tag"/>
                    <Button fx:id="addDoctorBtn" styleClass="primary-button" contentDisplay="LEFT" text="Add Doctor">
                        <graphic><FontIcon iconLiteral="fas-user-plus" iconSize="13"/></graphic>
                    </Button>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <HBox styleClass="search-input-box" alignment="CENTER_LEFT" spacing="6">
                        <FontIcon iconLiteral="fas-search" iconSize="13" styleClass="search-icon"/>
                        <TextField fx:id="searchField" promptText="Search by name or specialization..."
                                   styleClass="search-field" prefWidth="280" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label text="Department:" styleClass="filter-label"/>
                    <ComboBox fx:id="departmentFilter" promptText="All Departments" prefWidth="180" styleClass="filter-combo"/>
                </HBox>

                <fx:include fx:id="doctorTable"
                            source="/hospital/management/frontend/components/table/doctor-table.fxml"
                            VBox.vgrow="ALWAYS"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom><fx:include source="/hospital/management/frontend/components/footer/footer.fxml"/></bottom>
    </BorderPane>

    <fx:include fx:id="formDialog" source="/hospital/management/frontend/components/formdialog/form-dialog.fxml"/>
    <fx:include fx:id="confirmModal" source="/hospital/management/frontend/components/modal/modal.fxml"/>

    <StackPane StackPane.alignment="BOTTOM_RIGHT" styleClass="toast-anchor" pickOnBounds="false">
        <fx:include fx:id="toast" source="/hospital/management/frontend/components/toast/toast.fxml"/>
    </StackPane>
</StackPane>
