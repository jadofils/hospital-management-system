<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import java.net.URL?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="hospital.management.pages.dashboard.DashboardController">

    <stylesheets>
        <URL value="@../../css/global.css"/>
        <URL value="@../../css/dashboard.css"/>
        <URL value="@../../css/stats.css"/>
        <URL value="@../../css/table.css"/>
        <URL value="@../../css/buttons.css"/>
        <URL value="@../../css/alerts.css"/>
        <URL value="@../../css/spinner.css"/>
    </stylesheets>

    <BorderPane fx:id="dashboardRoot" styleClass="page-root">

    <top>
        <fx:include source="/hospital/management/frontend/components/navbar/navbar.fxml"/>
    </top>

    <left>
        <fx:include fx:id="sidebar" source="/hospital/management/frontend/components/sidebar/sidebar.fxml"/>
    </left>

    <right>
        <fx:include fx:id="rightSidebar" source="/hospital/management/frontend/components/right-sidebar/right-sidebar.fxml"/>
    </right>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox styleClass="dashboard-content" spacing="20">

                <!-- Page title -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-th-large" iconSize="18" styleClass="page-title-icon"/>
                    <Label text="Dashboard" styleClass="section-title"/>
                </HBox>

                <!-- Stats row -->
                <fx:include fx:id="statsWidget"
                            source="/hospital/management/frontend/components/stats/stats-widget.fxml"/>

                <!-- Charts row -->
                <HBox spacing="16" styleClass="dashboard-section">
                    <VBox styleClass="chart-panel" HBox.hgrow="ALWAYS" spacing="8">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fas-chart-bar" iconSize="14" styleClass="chart-title-icon"/>
                            <Label text="Monthly Admissions" styleClass="chart-title"/>
                        </HBox>
                        <BarChart fx:id="admissionsChart" prefHeight="260" animated="false">
                            <xAxis><CategoryAxis fx:id="admissionsXAxis" label="Month"/></xAxis>
                            <yAxis><NumberAxis   fx:id="admissionsYAxis" label="Patients"/></yAxis>
                        </BarChart>
                    </VBox>
                    <VBox styleClass="chart-panel" prefWidth="300" spacing="8">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fas-chart-pie" iconSize="14" styleClass="chart-title-icon"/>
                            <Label text="Patient Status" styleClass="chart-title"/>
                        </HBox>
                        <PieChart fx:id="statusChart" prefHeight="260" animated="false"/>
                    </VBox>
                </HBox>

                <!-- Quick actions -->
                <HBox fx:id="quickActionsBox" styleClass="quick-actions" spacing="10" alignment="CENTER_LEFT">
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-bolt" iconSize="13" styleClass="label-tag-icon"/>
                        <Label text="Quick Actions:" styleClass="label-tag"/>
                    </HBox>
                    <Button fx:id="newPatientBtn" styleClass="quick-action-btn" contentDisplay="LEFT" text="New Patient"
                            onAction="#handleNewPatient">
                        <graphic><FontIcon iconLiteral="fas-user-plus" iconSize="13"/></graphic>
                    </Button>
                    <Button fx:id="newAppointmentBtn" styleClass="quick-action-btn" contentDisplay="LEFT" text="Appointment"
                            onAction="#handleNewAppointment">
                        <graphic><FontIcon iconLiteral="fas-calendar-plus" iconSize="13"/></graphic>
                    </Button>
                    <Button fx:id="generateReportBtn" styleClass="quick-action-btn" contentDisplay="LEFT" text="Generate Report"
                            onAction="#handleGenerateReport">
                        <graphic><FontIcon iconLiteral="fas-file-export" iconSize="13"/></graphic>
                    </Button>
                    <Button fx:id="processBillingBtn" styleClass="quick-action-btn" contentDisplay="LEFT" text="Process Billing"
                            onAction="#handleProcessBilling">
                        <graphic><FontIcon iconLiteral="fas-file-invoice-dollar" iconSize="13"/></graphic>
                    </Button>
                </HBox>

                <!-- Recent patients table -->
                <VBox styleClass="recent-table-panel" spacing="10">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-history" iconSize="15" styleClass="page-title-icon"/>
                        <Label text="Recent Patients" styleClass="section-title"/>
                    </HBox>
                    <TableView fx:id="recentTable" prefHeight="220">
                        <columns>
                            <TableColumn fx:id="recentIdCol"     text="ID"     prefWidth="80"/>
                            <TableColumn fx:id="recentNameCol"   text="Name"   prefWidth="180"/>
                            <TableColumn fx:id="recentAgeCol"    text="Age"    prefWidth="60"/>
                            <TableColumn fx:id="recentStatusCol" text="Status" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Team directory (admin-only; lets you see every account/doctor to test with) -->
                <VBox fx:id="teamDirectoryBox" styleClass="recent-table-panel" spacing="10">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-users" iconSize="15" styleClass="page-title-icon"/>
                        <Label text="System Users" styleClass="section-title"/>
                    </HBox>
                    <TableView fx:id="usersTable" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="userUsernameCol" text="Username" prefWidth="220"/>
                            <TableColumn fx:id="userEmailCol"    text="Email"    prefWidth="240"/>
                            <TableColumn fx:id="userRoleCol"     text="Role"     prefWidth="140"/>
                        </columns>
                    </TableView>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-user-md" iconSize="15" styleClass="page-title-icon"/>
                        <Label text="Doctors" styleClass="section-title"/>
                    </HBox>
                    <TableView fx:id="doctorsTable" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="doctorNameCol"  text="Name"           prefWidth="220"/>
                            <TableColumn fx:id="doctorEmailCol" text="Login Email"    prefWidth="240"/>
                            <TableColumn fx:id="doctorSpecCol"  text="Specialization" prefWidth="180"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Patient Feedback Submission (for patients) -->
                <VBox fx:id="feedbackSubmissionBox" styleClass="recent-table-panel" spacing="14">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-comment-dots" iconSize="15" styleClass="page-title-icon"/>
                        <Label text="Submit Feedback" styleClass="section-title"/>
                    </HBox>
                    <VBox spacing="10" styleClass="card">
                        <Label text="We value your feedback! Please share your experience with us." styleClass="body-text"/>
                        
                        <VBox spacing="4">
                            <Label text="Appointment (Optional)" styleClass="form-field-label"/>
                            <ComboBox fx:id="feedbackAppointmentDropdown" promptText="Select an appointment (or leave blank for general feedback)" maxWidth="Infinity"/>
                        </VBox>
                        
                        <VBox spacing="4">
                            <Label text="Rating" styleClass="form-field-label"/>
                            <Spinner fx:id="feedbackRating" prefWidth="120" editable="true"/>
                        </VBox>
                        
                        <VBox spacing="4">
                            <Label text="Comments" styleClass="form-field-label"/>
                            <TextArea fx:id="feedbackComments" promptText="Tell us about your experience..." 
                                      wrapText="true" prefRowCount="4" styleClass="form-input"/>
                        </VBox>
                        
                        <HBox alignment="CENTER_RIGHT">
                            <Button fx:id="submitFeedbackBtn" styleClass="primary-button" text="Submit Feedback" contentDisplay="LEFT">
                                <graphic><FontIcon iconLiteral="fas-paper-plane" iconSize="13"/></graphic>
                            </Button>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Feedback Display (for admin/doctor) -->
                <VBox fx:id="feedbackDisplayBox" styleClass="recent-table-panel" spacing="10">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-comments" iconSize="15" styleClass="page-title-icon"/>
                        <Label text="Patient Feedback" styleClass="section-title"/>
                    </HBox>
                    
                    <!-- Admin/Doctor Feedback Creation Form -->
                    <VBox spacing="10" styleClass="card">
                        <Label text="Submit New Feedback" styleClass="subsection-title"/>
                        
                        <VBox spacing="4">
                            <Label text="Patient" styleClass="form-field-label"/>
                            <ComboBox fx:id="adminFeedbackPatientDropdown" promptText="Select a patient" maxWidth="Infinity"/>
                        </VBox>
                        
                        <VBox spacing="4">
                            <Label text="Appointment (Optional)" styleClass="form-field-label"/>
                            <ComboBox fx:id="adminFeedbackAppointmentDropdown" promptText="Select an appointment (optional)" maxWidth="Infinity"/>
                        </VBox>
                        
                        <VBox spacing="4">
                            <Label text="Rating" styleClass="form-field-label"/>
                            <Spinner fx:id="adminFeedbackRating" prefWidth="120" editable="true"/>
                        </VBox>
                        
                        <VBox spacing="4">
                            <Label text="Comments" styleClass="form-field-label"/>
                            <TextArea fx:id="adminFeedbackComments" promptText="Enter feedback comments..." 
                                      wrapText="true" prefRowCount="3" styleClass="form-input"/>
                        </VBox>
                        
                        <HBox alignment="CENTER_RIGHT">
                            <Button fx:id="submitAdminFeedbackBtn" styleClass="primary-button" text="Submit Feedback" contentDisplay="LEFT">
                                <graphic><FontIcon iconLiteral="fas-paper-plane" iconSize="13"/></graphic>
                            </Button>
                        </HBox>
                    </VBox>
                    
                    <TableView fx:id="feedbackTable" prefHeight="250">
                        <columns>
                            <TableColumn fx:id="feedbackSubmitterCol" text="Submitted By" prefWidth="150"/>
                            <TableColumn fx:id="feedbackPatientCol" text="About Patient" prefWidth="150"/>
                            <TableColumn fx:id="feedbackAppointmentCol" text="Appointment" prefWidth="130"/>
                            <TableColumn fx:id="feedbackRatingCol" text="Rating" prefWidth="70"/>
                            <TableColumn fx:id="feedbackCommentsCol" text="Comments" prefWidth="250"/>
                            <TableColumn fx:id="feedbackDateCol" text="Date" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="/hospital/management/frontend/components/footer/footer.fxml"/>
    </bottom>
    </BorderPane>

    <StackPane StackPane.alignment="BOTTOM_RIGHT" styleClass="toast-anchor" pickOnBounds="false">
        <fx:include fx:id="toast" source="/hospital/management/frontend/components/toast/toast.fxml"/>
    </StackPane>
</StackPane>