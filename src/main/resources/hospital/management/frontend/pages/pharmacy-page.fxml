<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="hospital.management.pages.pharmacy.PharmacyController">

    <stylesheets>
        <URL value="@../../css/global.css"/>
        <URL value="@../../css/table.css"/>
        <URL value="@../../css/tabs.css"/>
        <URL value="@../../css/buttons.css"/>
        <URL value="@../../css/search.css"/>
        <URL value="@../../css/form.css"/>
        <URL value="@../../css/modal.css"/>
        <URL value="@../../css/alerts.css"/>
        <URL value="@../../css/spinner.css"/>
    </stylesheets>

    <BorderPane styleClass="page-root">

    <top><fx:include source="/hospital/management/frontend/components/navbar/navbar.fxml"/></top>
    <left><fx:include fx:id="sidebar" source="/hospital/management/frontend/components/sidebar/sidebar.fxml"/></left>
    <right><fx:include fx:id="rightSidebar" source="/hospital/management/frontend/components/right-sidebar/right-sidebar.fxml"/></right>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox styleClass="page-content" spacing="16">

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-pills" iconSize="18" styleClass="page-title-icon"/>
                    <Label text="Pharmacy" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="continueBtn" styleClass="continue-button"/>
                </HBox>

                <TabPane fx:id="pharmacyTabs" styleClass="detail-tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

                    <!-- Inventory tab -->
                    <Tab text="Medication Inventory">
                        <VBox spacing="12" styleClass="tab-content">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <HBox styleClass="search-input-box" alignment="CENTER_LEFT" spacing="6">
                                    <FontIcon iconLiteral="fas-search" iconSize="13" styleClass="search-icon"/>
                                    <TextField fx:id="inventorySearchField" promptText="Search medications..."
                                               styleClass="search-field" prefWidth="260"/>
                                </HBox>
                                <Button fx:id="newMedicationBtn" styleClass="secondary-button" contentDisplay="LEFT" text="New Medication">
                                    <graphic><FontIcon iconLiteral="fas-capsules" iconSize="13"/></graphic>
                                </Button>
                                <Button fx:id="addMedBtn" styleClass="primary-button" contentDisplay="LEFT" text="Add Inventory Batch">
                                    <graphic><FontIcon iconLiteral="fas-plus" iconSize="13"/></graphic>
                                </Button>
                                <Region HBox.hgrow="ALWAYS"/>
                                <fx:include fx:id="inventorySortBar" source="/hospital/management/frontend/components/sortbar/sort-bar.fxml"/>
                            </HBox>
                            <fx:include fx:id="inventoryTable"
                                        source="/hospital/management/frontend/components/table/medical-inventory-table.fxml"
                                        VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </Tab>

                    <!-- Pending prescriptions tab -->
                    <Tab text="Pending Prescriptions">
                        <VBox spacing="12" styleClass="tab-content">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Prescriptions awaiting dispensing" styleClass="label-tag" HBox.hgrow="ALWAYS"/>
                                <fx:include fx:id="pendingSortBar" source="/hospital/management/frontend/components/sortbar/sort-bar.fxml"/>
                            </HBox>
                            <fx:include fx:id="pendingPrescriptionsTable"
                                        source="/hospital/management/frontend/components/table/prescription-table.fxml"
                                        VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </Tab>

                    <!-- Low stock tab -->
                    <Tab text="Low Stock Alerts">
                        <VBox spacing="12" styleClass="tab-content">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="14" styleClass="text-warning"/>
                                <Label text="Items at or below reorder level" styleClass="label-tag" HBox.hgrow="ALWAYS"/>
                                <fx:include fx:id="lowStockSortBar" source="/hospital/management/frontend/components/sortbar/sort-bar.fxml"/>
                            </HBox>
                            <fx:include fx:id="lowStockTable"
                                        source="/hospital/management/frontend/components/table/medical-inventory-table.fxml"
                                        VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </Tab>

                </TabPane>
            </VBox>
        </ScrollPane>
    </center>

    <bottom><fx:include source="/hospital/management/frontend/components/footer/footer.fxml"/></bottom>
    </BorderPane>

    <fx:include fx:id="formDialog" source="/hospital/management/frontend/components/formdialog/form-dialog.fxml"/>
    <fx:include fx:id="confirmModal" source="/hospital/management/frontend/components/modal/modal.fxml"/>
    <fx:include fx:id="detailView" source="/hospital/management/frontend/components/detailview/detail-view.fxml"/>

    <StackPane StackPane.alignment="BOTTOM_RIGHT" styleClass="toast-anchor" pickOnBounds="false">
        <fx:include fx:id="toast" source="/hospital/management/frontend/components/toast/toast.fxml"/>
    </StackPane>
</StackPane>
