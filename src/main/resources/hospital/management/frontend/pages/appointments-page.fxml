<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="hospital.management.pages.clinical.AppointmentsPageController">

    <stylesheets>
        <URL value="@../../css/global.css"/>
        <URL value="@../../css/calendar.css"/>
        <URL value="@../../css/table.css"/>
        <URL value="@../../css/buttons.css"/>
        <URL value="@../../css/modal.css"/>
        <URL value="@../../css/alerts.css"/>
        <URL value="@../../css/spinner.css"/>
    </stylesheets>

    <BorderPane styleClass="page-root">

    <top>
        <fx:include source="/hospital/management/frontend/components/navbar/navbar.fxml"/>
    </top>

    <left>
        <fx:include fx:id="sidebar" source="/hospital/management/frontend/components/sidebar/sidebar.fxml"/>
    </left>

    <right>
        <fx:include fx:id="rightSidebar" source="/hospital/management/frontend/components/right-sidebar/right-sidebar.fxml"/>
    </right>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
        <VBox styleClass="page-content" spacing="16">

            <!-- Page title -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fas-calendar-check" iconSize="18" styleClass="page-title-icon"/>
                <Label text="Appointments" styleClass="section-title"/>
            </HBox>

            <HBox spacing="20" alignment="TOP_LEFT">
                <!-- Calendar on the left -->
                <fx:include fx:id="calendar"
                            source="/hospital/management/frontend/components/calendar/calendar.fxml"/>

                <!-- Appointments list on the right -->
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-list-ul" iconSize="14" styleClass="page-title-icon"/>
                        <Label text="Appointments for selected date" styleClass="subheading"
                               HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="billingFilter" styleClass="filter-combobox" prefWidth="130"/>
                        <Button fx:id="importBtn" styleClass="secondary-button"
                                contentDisplay="LEFT" text="Import">
                            <graphic><FontIcon iconLiteral="fas-file-import" iconSize="13"/></graphic>
                        </Button>
                        <Button fx:id="exportBtn" styleClass="secondary-button"
                                contentDisplay="LEFT" text="Export">
                            <graphic><FontIcon iconLiteral="fas-file-export" iconSize="13"/></graphic>
                        </Button>
                        <Button fx:id="addAppointmentBtn" styleClass="primary-button"
                                contentDisplay="LEFT" text="New Appointment">
                            <graphic><FontIcon iconLiteral="fas-calendar-plus" iconSize="13"/></graphic>
                        </Button>
                        <Button fx:id="continueBtn" styleClass="continue-button"/>
                        <fx:include fx:id="sortBar" source="/hospital/management/frontend/components/sortbar/sort-bar.fxml"/>
                    </HBox>

                    <fx:include fx:id="appointmentTable"
                                source="/hospital/management/frontend/components/table/appointment-table.fxml"
                                VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>
        </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="/hospital/management/frontend/components/footer/footer.fxml"/>
    </bottom>
    </BorderPane>

    <fx:include fx:id="formDialog" source="/hospital/management/frontend/components/formdialog/form-dialog.fxml"/>
    <fx:include fx:id="confirmModal" source="/hospital/management/frontend/components/modal/modal.fxml"/>
    <fx:include fx:id="detailView" source="/hospital/management/frontend/components/detailview/detail-view.fxml"/>

    <StackPane StackPane.alignment="BOTTOM_RIGHT" styleClass="toast-anchor" pickOnBounds="false">
        <fx:include fx:id="toast" source="/hospital/management/frontend/components/toast/toast.fxml"/>
    </StackPane>
</StackPane>