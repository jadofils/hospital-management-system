<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hospital.management.pages.AppointmentsPageController"
            styleClass="page-root">

    <stylesheets>
        <URL value="@../../css/global.css"/>
        <URL value="@../../css/calendar.css"/>
        <URL value="@../../css/table.css"/>
        <URL value="@../../css/buttons.css"/>
    </stylesheets>

    <top>
        <fx:include source="/hospital/management/frontend/components/navbar/navbar.fxml"/>
    </top>

    <left>
        <fx:include fx:id="sidebar" source="/hospital/management/frontend/components/sidebar/sidebar.fxml"/>
    </left>

    <center>
        <VBox styleClass="page-content" spacing="16">

            <!-- Page title -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fas-calendar-check" iconSize="18" styleClass="page-title-icon"/>
                <Label text="Appointments" styleClass="section-title"/>
            </HBox>

            <HBox spacing="20" alignment="TOP_LEFT">
                <!-- Calendar on the left -->
                <fx:include fx:id="calendar"
                            source="/hospital/management/frontend/components/calendar/calendar.fxml"/>

                <!-- Appointments list on the right -->
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-list-ul" iconSize="14" styleClass="page-title-icon"/>
                        <Label text="Appointments for selected date" styleClass="subheading"
                               HBox.hgrow="ALWAYS"/>
                        <Button styleClass="primary-button" contentDisplay="LEFT" text="New Appointment">
                            <graphic><FontIcon iconLiteral="fas-calendar-plus" iconSize="13"/></graphic>
                        </Button>
                    </HBox>

                    <TableView fx:id="appointmentsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="apptIdCol"      text="ID"      prefWidth="70"/>
                            <TableColumn fx:id="apptPatientCol" text="Patient"  prefWidth="150"/>
                            <TableColumn fx:id="apptDoctorCol"  text="Doctor"   prefWidth="140"/>
                            <TableColumn fx:id="apptTimeCol"    text="Time"     prefWidth="80"/>
                            <TableColumn fx:id="apptStatusCol"  text="Status"   prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="/hospital/management/frontend/components/footer/footer.fxml"/>
    </bottom>
</BorderPane>