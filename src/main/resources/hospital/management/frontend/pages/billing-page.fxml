<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="hospital.management.pages.finance.InvoicePageController">

    <stylesheets>
        <URL value="@../../css/global.css"/>
        <URL value="@../../css/table.css"/>
        <URL value="@../../css/stats.css"/>
        <URL value="@../../css/buttons.css"/>
        <URL value="@../../css/modal.css"/>
        <URL value="@../../css/alerts.css"/>
        <URL value="@../../css/spinner.css"/>
    </stylesheets>

    <BorderPane styleClass="page-root">

    <top>
        <fx:include source="/hospital/management/frontend/components/navbar/navbar.fxml"/>
    </top>

    <left>
        <fx:include fx:id="sidebar" source="/hospital/management/frontend/components/sidebar/sidebar.fxml"/>
    </left>

    <right>
        <fx:include fx:id="rightSidebar" source="/hospital/management/frontend/components/right-sidebar/right-sidebar.fxml"/>
    </right>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
        <VBox styleClass="page-content" spacing="16">

            <!-- Page title -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fas-file-invoice-dollar" iconSize="18" styleClass="page-title-icon"/>
                <Label text="Billing" styleClass="section-title"/>
            </HBox>

            <!-- Summary cards -->
            <HBox spacing="16">
                <VBox styleClass="stat-card stat-card-blue" spacing="6" HBox.hgrow="ALWAYS">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-chart-line" iconSize="16" styleClass="stat-icon"/>
                        <Label text="Total Revenue" styleClass="stat-label"/>
                    </HBox>
                    <Label fx:id="totalRevenueLabel" text="\$0.00" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card stat-card-green" spacing="6" HBox.hgrow="ALWAYS">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-check-circle" iconSize="16" styleClass="stat-icon"/>
                        <Label text="Paid" styleClass="stat-label"/>
                    </HBox>
                    <Label fx:id="paidLabel" text="\$0.00" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card stat-card-yellow" spacing="6" HBox.hgrow="ALWAYS">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-clock" iconSize="16" styleClass="stat-icon"/>
                        <Label text="Pending" styleClass="stat-label"/>
                    </HBox>
                    <Label fx:id="pendingLabel" text="\$0.00" styleClass="stat-value"/>
                </VBox>
            </HBox>

            <!-- Toolbar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="newInvoiceBtn" styleClass="primary-button" contentDisplay="LEFT" text="New Invoice">
                    <graphic><FontIcon iconLiteral="fas-plus" iconSize="13"/></graphic>
                </Button>
                <Button fx:id="importCsvBtn" styleClass="secondary-button" contentDisplay="LEFT" text="Import CSV">
                    <graphic><FontIcon iconLiteral="fas-file-import" iconSize="13"/></graphic>
                </Button>
                <Button fx:id="exportCsvBtn" styleClass="secondary-button" contentDisplay="LEFT" text="Export CSV">
                    <graphic><FontIcon iconLiteral="fas-file-export" iconSize="13"/></graphic>
                </Button>
                <Button fx:id="printReportBtn" styleClass="secondary-button" contentDisplay="LEFT" text="Print Report">
                    <graphic><FontIcon iconLiteral="fas-print" iconSize="13"/></graphic>
                </Button>
            </HBox>

            <!-- Invoice table -->
            <fx:include fx:id="invoiceTable"
                        source="/hospital/management/frontend/components/table/invoice-table.fxml"
                        VBox.vgrow="ALWAYS"/>
        </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="/hospital/management/frontend/components/footer/footer.fxml"/>
    </bottom>
    </BorderPane>

    <fx:include fx:id="formDialog" source="/hospital/management/frontend/components/formdialog/form-dialog.fxml"/>
    <fx:include fx:id="confirmModal" source="/hospital/management/frontend/components/modal/modal.fxml"/>
    <fx:include fx:id="detailView" source="/hospital/management/frontend/components/detailview/detail-view.fxml"/>

    <StackPane StackPane.alignment="BOTTOM_RIGHT" styleClass="toast-anchor" pickOnBounds="false">
        <fx:include fx:id="toast" source="/hospital/management/frontend/components/toast/toast.fxml"/>
    </StackPane>
</StackPane>
