<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.pages.components.shared.layout.NavbarController"
      fx:id="navbarRoot"
      styleClass="navbar"
      spacing="4"
      alignment="CENTER_LEFT">

    <stylesheets>
        <URL value="@../../../css/navbar.css"/>
    </stylesheets>

    <HBox spacing="6" alignment="CENTER_LEFT" styleClass="navbar-brand-box">
        <FontIcon iconLiteral="fas-hospital" iconSize="20" styleClass="navbar-brand-icon"/>
        <Label text="HMS" styleClass="navbar-brand"/>
    </HBox>

    <Region minWidth="24"/>

    <!-- Dashboard, Patients, Appointments and Billing removed from navbar per request -->

    <Region HBox.hgrow="ALWAYS"/>

    <StackPane styleClass="navbar-bell-wrap">
        <Button fx:id="notificationBellBtn" styleClass="navbar-icon-btn" onAction="#handleNotifications">
            <graphic><FontIcon iconLiteral="fas-bell" iconSize="16"/></graphic>
        </Button>
        <Label fx:id="notifBadge" text="" styleClass="navbar-notif-badge"
               StackPane.alignment="TOP_RIGHT" visible="false" managed="false"/>
    </StackPane>
    <Button fx:id="profileBtn" styleClass="navbar-btn" onAction="#handleProfile" contentDisplay="LEFT" text="User">
        <graphic><FontIcon iconLiteral="fas-user-circle" iconSize="15"/></graphic>
    </Button>
</HBox>