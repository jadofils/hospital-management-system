<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.pages.components.shared.layout.NavbarController"
      fx:id="navbarRoot"
      styleClass="navbar"
      spacing="4"
      alignment="CENTER_LEFT">

    <stylesheets>
        <URL value="@../../../css/navbar.css"/>
    </stylesheets>

    <HBox spacing="6" alignment="CENTER_LEFT" styleClass="navbar-brand-box">
        <FontIcon iconLiteral="fas-hospital" iconSize="20" styleClass="navbar-brand-icon"/>
        <Label text="HMS" styleClass="navbar-brand"/>
    </HBox>

    <Region minWidth="24"/>

    <Button styleClass="navbar-btn" onAction="#handleDashboard" contentDisplay="LEFT" text="Dashboard">
        <graphic><FontIcon iconLiteral="fas-th-large" iconSize="13"/></graphic>
    </Button>
    <Button styleClass="navbar-btn" onAction="#handlePatients" contentDisplay="LEFT" text="Patients">
        <graphic><FontIcon iconLiteral="fas-user-injured" iconSize="13"/></graphic>
    </Button>
    <Button styleClass="navbar-btn" onAction="#handleAppointments" contentDisplay="LEFT" text="Appointments">
        <graphic><FontIcon iconLiteral="fas-calendar-check" iconSize="13"/></graphic>
    </Button>
    <Button styleClass="navbar-btn" onAction="#handleBilling" contentDisplay="LEFT" text="Billing">
        <graphic><FontIcon iconLiteral="fas-file-invoice-dollar" iconSize="13"/></graphic>
    </Button>

    <Region HBox.hgrow="ALWAYS"/>

    <Button styleClass="navbar-icon-btn" onAction="#handleProfile">
        <graphic><FontIcon iconLiteral="fas-bell" iconSize="16"/></graphic>
    </Button>
    <Button styleClass="navbar-btn" onAction="#handleProfile" contentDisplay="LEFT" text="Dr. Admin">
        <graphic><FontIcon iconLiteral="fas-user-circle" iconSize="15"/></graphic>
    </Button>
</HBox>