<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.pages.components.NotificationController"
      styleClass="notification-panel"
      spacing="0">

    <stylesheets>
        <URL value="@../../../css/notification.css"/>
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="notification-header" spacing="8" alignment="CENTER_LEFT">
        <Label text="Notifications" styleClass="notification-header-title" HBox.hgrow="ALWAYS"/>
        <Label fx:id="unreadCount" text="0" styleClass="role-badge"/>
    </HBox>

    <!-- Notification list (populated by controller) -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="notificationList" spacing="0"/>
    </ScrollPane>

    <!-- Footer -->
    <HBox styleClass="notification-footer">
        <Button text="View all notifications" styleClass="view-all-btn"
                onAction="#handleViewAll"/>
    </HBox>
</VBox>