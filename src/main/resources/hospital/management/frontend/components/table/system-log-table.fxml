<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.pages.components.log.SystemLogTableController"
      spacing="0"
      VBox.vgrow="ALWAYS">

    <stylesheets>
        <URL value="@../../../css/table.css"/>
    </stylesheets>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn"        text="ID"        prefWidth="80"/>
            <TableColumn fx:id="userIdColumn"    text="User ID"   prefWidth="100"/>
            <TableColumn fx:id="levelColumn"     text="Level"     prefWidth="100"/>
            <TableColumn fx:id="sourceColumn"    text="Source"    prefWidth="180"/>
            <TableColumn fx:id="messageColumn"   text="Message"   prefWidth="400"/>
            <TableColumn fx:id="timestampColumn" text="Timestamp" prefWidth="160"/>
        </columns>
    </TableView>

    <Pagination fx:id="pagination" pageCount="1" maxPageIndicatorCount="5"/>
</VBox>
