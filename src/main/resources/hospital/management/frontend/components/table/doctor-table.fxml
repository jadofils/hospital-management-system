<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.pages.components.doctor.DoctorTableController"
      spacing="0"
      VBox.vgrow="ALWAYS">

    <stylesheets>
        <URL value="@../../../css/table.css"/>
    </stylesheets>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn"            text="ID"             prefWidth="80"/>
            <TableColumn fx:id="nameColumn"          text="Name"           prefWidth="160"/>
            <TableColumn fx:id="specializationColumn" text="Specialization" prefWidth="150"/>
            <TableColumn fx:id="departmentColumn"    text="Department"    prefWidth="130"/>
            <TableColumn fx:id="phoneColumn"         text="Phone"         prefWidth="120"/>
            <TableColumn fx:id="emailColumn"         text="Email"         prefWidth="180"/>
            <TableColumn fx:id="actionsColumn"        text="Actions"        prefWidth="90"/>
        </columns>
    </TableView>

    <Pagination fx:id="pagination" pageCount="1" maxPageIndicatorCount="5"/>
</VBox>
