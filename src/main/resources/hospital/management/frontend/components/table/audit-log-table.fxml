<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.pages.components.log.AuditLogTableController"
      spacing="0"
      VBox.vgrow="ALWAYS">

    <stylesheets>
        <URL value="@../../../css/table.css"/>
    </stylesheets>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn"        text="ID"        prefWidth="80"/>
            <TableColumn fx:id="userIdColumn"    text="User ID"   prefWidth="120"/>
            <TableColumn fx:id="actionColumn"    text="Action"    prefWidth="100"/>
            <TableColumn fx:id="tableColumn"     text="Table"     prefWidth="140"/>
            <TableColumn fx:id="recordIdColumn"  text="Record ID" prefWidth="140"/>
            <TableColumn fx:id="createdAtColumn" text="Timestamp" prefWidth="150"/>
        </columns>
    </TableView>

    <Pagination fx:id="pagination" pageCount="1" maxPageIndicatorCount="5"/>
</VBox>
