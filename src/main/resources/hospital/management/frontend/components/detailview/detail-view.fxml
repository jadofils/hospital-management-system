<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="hospital.management.pages.components.shared.feedback.DetailViewController"
           fx:id="detailOverlay"
           styleClass="modal-overlay"
           visible="false"
           managed="false">

    <stylesheets>
        <URL value="@../../../css/modal.css"/>
        <URL value="@../../../css/buttons.css"/>
        <URL value="@../../../css/form.css"/>
    </stylesheets>

    <VBox fx:id="detailBox" styleClass="modal-box,form-dialog-box" StackPane.alignment="CENTER">
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <FontIcon fx:id="detailIcon" iconLiteral="fas-info-circle" iconSize="16" styleClass="page-title-icon"/>
            <Label fx:id="detailTitle" text="Details" styleClass="modal-title"
                   HBox.hgrow="ALWAYS"/>
            <Button text="x" styleClass="modal-close-btn" onAction="#handleClose"/>
        </HBox>

        <!-- Fields (populated dynamically per entity) -->
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
            <VBox fx:id="detailFieldsBox" styleClass="form-dialog-fields" spacing="10"/>
        </ScrollPane>

        <!-- Footer -->
        <HBox styleClass="modal-footer" spacing="10">
            <Button text="Close" styleClass="secondary-button" onAction="#handleClose"/>
        </HBox>
    </VBox>
</StackPane>
