<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="hospital.management.pages.components.PatientFormController"
      spacing="20"
      styleClass="card"
      prefWidth="560">

    <stylesheets>
        <URL value="@../../../css/form.css"/>
        <URL value="@../../../css/buttons.css"/>
    </stylesheets>

    <!-- Step indicators -->
    <HBox spacing="16" alignment="CENTER">
        <Label fx:id="step1Indicator" text="1" styleClass="step-indicator active"/>
        <Label text="Personal Info" styleClass="label-tag"/>
        <Label text="───" styleClass="text-muted"/>
        <Label fx:id="step2Indicator" text="2" styleClass="step-indicator"/>
        <Label text="Contact" styleClass="label-tag"/>
        <Label text="───" styleClass="text-muted"/>
        <Label fx:id="step3Indicator" text="3" styleClass="step-indicator"/>
        <Label text="Medical" styleClass="label-tag"/>
    </HBox>

    <!-- Step 1: Personal Info -->
    <VBox fx:id="step1Pane" spacing="14">
        <Label text="Personal Information" styleClass="form-section-title"/>
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="First Name" styleClass="form-field-label"/>
                <TextField fx:id="firstNameField" promptText="First name" styleClass="form-input"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Last Name" styleClass="form-field-label"/>
                <TextField fx:id="lastNameField" promptText="Last name" styleClass="form-input"/>
            </VBox>
        </HBox>
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Date of Birth" styleClass="form-field-label"/>
                <DatePicker fx:id="dobPicker" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Gender" styleClass="form-field-label"/>
                <ComboBox fx:id="genderCombo" maxWidth="Infinity" styleClass="form-combo"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Step 2: Contact -->
    <VBox fx:id="step2Pane" spacing="14" visible="false" managed="false">
        <Label text="Contact Information" styleClass="form-section-title"/>
        <VBox spacing="4">
            <Label text="Phone" styleClass="form-field-label"/>
            <TextField fx:id="phoneField" promptText="e.g. 555-0100" styleClass="form-input"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Email" styleClass="form-field-label"/>
            <TextField fx:id="emailField" promptText="patient@example.com" styleClass="form-input"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Address" styleClass="form-field-label"/>
            <TextField fx:id="addressField" promptText="Street, City, Country" styleClass="form-input"/>
        </VBox>
    </VBox>

    <!-- Step 3: Medical -->
    <VBox fx:id="step3Pane" spacing="14" visible="false" managed="false">
        <Label text="Medical Information" styleClass="form-section-title"/>
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Blood Group" styleClass="form-field-label"/>
                <ComboBox fx:id="bloodGroupCombo" maxWidth="Infinity" styleClass="form-combo"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Assigned Doctor" styleClass="form-field-label"/>
                <ComboBox fx:id="assignedDoctorCombo" maxWidth="Infinity" styleClass="form-combo"/>
            </VBox>
        </HBox>
        <VBox spacing="4">
            <Label text="Allergies / Notes" styleClass="form-field-label"/>
            <TextArea fx:id="allergiesArea" promptText="List any known allergies..."
                      prefRowCount="3" styleClass="form-input"/>
        </VBox>
    </VBox>

    <!-- Validation -->
    <Label fx:id="validationMessage" styleClass="validation-error" text=""/>

    <!-- Navigation buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="backBtn"   text="Back"   styleClass="secondary-button"
                visible="false" managed="false" onAction="#handleBack"/>
        <Button fx:id="nextBtn"   text="Next"   styleClass="primary-button" onAction="#handleNext"/>
        <Button fx:id="submitBtn" text="Submit" styleClass="success-button"
                visible="false" managed="false" onAction="#handleSubmit"/>
    </HBox>
</VBox>